# SignBridge AI configuration.
# Copy to .env (never commit .env). Used by `docker compose` and by the Go API
# when run locally with `go run` (backend/.env, if present, takes precedence).

# --- Ports published on your machine (docker compose) ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Backend ---
# "production" disables development-only endpoints (POST /api/v1/meta/test).
APP_ENV=development
LOG_LEVEL=info
# Browser origins allowed to call the API. Must match the UI's URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=75s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Signs below this recognizer confidence are discarded before interpretation.
MIN_SIGN_CONFIDENCE=0.6

# --- Meta Model API (server-side only, never sent to the browser) ---
# Docs: https://dev.meta.ai/docs  Keys look like LLM_<id>_<secret>.
# META_API_KEY is also accepted as a fallback name.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
META_API_TIMEOUT=45s

# --- Frontend (baked in at image build time: rebuild after changing) ---
# URL the *browser* uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Show the developer tools (Meta connection test, manual interpretation test)
# in production builds. Always shown in `npm run dev`.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true
# Per-frame MediaPipe confidence a gesture needs before it counts (0-1).
NEXT_PUBLIC_GESTURE_MIN_CONFIDENCE=0.8
