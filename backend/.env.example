# Copy to .env and adjust. Never commit .env.

PORT=8080
APP_ENV=development
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Go duration strings (e.g. 10s, 1m).
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=25s
HTTP_SHUTDOWN_TIMEOUT=10s

# Meta Model API (not called in Phase 1).
# Fill these from official Meta documentation; do not guess values.
# The key stays on the server and is never sent to the frontend.
META_API_KEY=
META_MODEL=
META_API_BASE_URL=
META_API_TIMEOUT=20s
